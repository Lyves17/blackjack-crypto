{
  "name": "Crypto Blackjack (Node.js)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "waitFor": "onCreateCommand",
  "onCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "blackjack",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["server/index.js", "server/.env.example"]
    }
  }
}
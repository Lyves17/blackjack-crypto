MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/blackjack
PORT=3000
NODE_ENV=development
DOMAIN_NAME=blackjack-crypto.onrender.com

# URL publique du jeu, utilisee pour construire l'URL de callback SHKeeper
PUBLIC_URL=https://blackjack-crypto.onrender.com

# SHKeeper : passerelle de paiement auto-hebergee
SHKEEPER_URL=https://<shkeeper-domain>
SHKEEPER_API_KEY=<shkeeper-api-key>
SHKEEPER_FIAT=USD